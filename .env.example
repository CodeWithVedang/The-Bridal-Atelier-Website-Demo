# ─────────────────────────────────────────────────────────────────────────────
# THE BRIDAL ATELIER — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# Every value below is OPTIONAL. The site runs with none of them set: contact
# CTAs render disabled with an explanatory note rather than printing a fake
# number, and the site stays out of search indexes.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute origin of the deployed site, no trailing slash.
# Used for canonical URLs, sitemap entries and Open Graph image URLs.
# Defaults to http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search-engine indexing gate. DEFAULTS TO false ON PURPOSE.
# The Bridal Atelier is a demonstration brand. Indexing a fictional local
# business would place misleading business information in search results.
# Set to `true` only for a real, non-fictional deployment.
NEXT_PUBLIC_SITE_INDEXABLE=false

# ── Contact channels ─────────────────────────────────────────────────────────
# Leave these blank and the matching call-to-action renders DISABLED with a
# note naming the variable that enables it. Never substitute a made-up number.

# Digits only, including country code, no +, no spaces. Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Human-readable phone number as it should be displayed. Example: +91 98765 43210
NEXT_PUBLIC_PHONE=

# Public enquiries inbox. Example: studio@example.com
NEXT_PUBLIC_EMAIL=

# Single-line studio address. Omitted from the page and from LocalBusiness
# structured data when blank.
NEXT_PUBLIC_STUDIO_ADDRESS=

# City and region, used by LocalBusiness structured data when an address is set.
NEXT_PUBLIC_STUDIO_CITY=
NEXT_PUBLIC_STUDIO_REGION=
NEXT_PUBLIC_STUDIO_POSTAL_CODE=

# ── Social ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_PINTEREST_URL=

# ── Server-only ──────────────────────────────────────────────────────────────
# Integration seam for forwarding consultation requests to a CRM or inbox.
# READ BUT NEVER CALLED in this build: the brief requires that no external API
# is connected unless required. Wiring it is a documented one-function change.
# Must be https:// if set. Never prefix this with NEXT_PUBLIC_.
CONSULTATION_WEBHOOK_URL=
